{
  "manifest_version": 3,
  "name": "Conditional List Colors for Trello",
  "version": "1.0.0",
  "description": "Automatically styles and colors Trello lists conditionally based on card priorities and custom rules.",
  "permissions": ["storage"],
  "host_permissions": ["https://trello.com/*"],
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "Conditional List Color Rules"
  },
  "content_scripts": [
    {
      "matches": ["https://trello.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules.html",
        "assets/*",
        "icons/*"
      ],
      "matches": ["https://trello.com/*"]
    }
  ]
}

